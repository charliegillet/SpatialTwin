# Gemini 4 Argon Hackathon Configuration
# When set, direct Argon vision and managed Antigravity agent can make live API requests.
# When not set, the application cleanly runs in honest, labeled fixture/offline mode.
GEMINI_API_KEY=

# Hardware serial port for Arduino UNO R4 Minima (leave empty for automatic mock simulator)
# Example macOS: /dev/cu.usbmodem1101
SERIAL_PORT=
SERIAL_BAUD=115200

# Server settings
HOST=0.0.0.0
PORT=8000
SPATIALTWIN_MODE=demo
