# SpatialTwin configuration. Copy to .env (never committed) and fill in what you need; everything is optional.
# The server loads .env at startup; variables already set in the shell win. Start the app with ./run.sh.

# --- Gemini 4 Argon ------------------------------------------------------------------------------------------------
# Enables live Real2Sim readings (photo / sketch / PDF -> venue) and the live managed-agent team on gemini-4-argon.
# Without it every local path still works: planner, Simulation, saved runs, local agent lanes, virtual doors.
GEMINI_API_KEY=

# Real2Sim reading: thinking level (low | medium | high; default medium), streaming (1 | 0; default 1) and the number
# of critique rounds when graph checks find errors (default 1).
# SPATIALTWIN_REAL2SIM_THINKING=medium
# SPATIALTWIN_REAL2SIM_STREAM=1
# SPATIALTWIN_REAL2SIM_CRITIQUE_ROUNDS=1
# Folder of labelled saved runs offered as the Act 1 fallback (./run.sh sets runtime/saved-runs when it exists).
# SPATIALTWIN_REAL2SIM_FIXTURES_DIR=runtime/saved-runs

# --- Mode -----------------------------------------------------------------------------------------------------------
# demo (default) allows labelled saved runs and local lanes; production disables them.
SPATIALTWIN_MODE=demo

# --- Judges' phones (./run.sh --lan) --------------------------------------------------------------------------------
# 32+ characters: keeps phone QR links valid across restarts (unset: a random key per process; shorter: signs off).
# SPATIALTWIN_SIGN_SECRET=
# The address phones should use, when auto-detection picks the wrong network interface.
# SPATIALTWIN_SIGN_BASE_URL=http://192.168.1.20:8000

# --- Remote access (rarely needed) ----------------------------------------------------------------------------------
# Browser origins allowed by CORS (the built app is same-origin and needs nothing here).
SPATIALTWIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# A token that lets a non-loopback client use the whole API (X-API-Token header). Leave empty: phones use scoped links.
# SPATIALTWIN_API_TOKEN=

# --- Tabletop hardware (demo v1; not used at the hackathon) ---------------------------------------------------------
# Arduino UNO R4 serial port; empty uses the built-in simulator. Example macOS: /dev/cu.usbmodem1101
SERIAL_PORT=
SERIAL_BAUD=115200
