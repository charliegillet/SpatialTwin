# Gemini 4 Argon Hackathon Configuration
# When set, direct Argon vision and managed Antigravity agent can make live API requests.
# Missing credentials return unavailable. Fixtures/local comparison are explicit choices.
GEMINI_API_KEY=

# Hardware serial port for Arduino UNO R4 Minima (leave empty for automatic mock simulator)
# Example macOS: /dev/cu.usbmodem1101
SERIAL_PORT=
SERIAL_BAUD=115200

# Server settings
HOST=127.0.0.1
PORT=8000
SPATIALTWIN_MODE=demo
# Set production to disable fixture grounding and local demo investigations.
# SPATIALTWIN_MODE=production
SPATIALTWIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
